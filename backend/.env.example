DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=""
DB_NAME=ncb_demo_kit

FRONTEND_URL=http://localhost:5173
PORT=5000

# TTS reliability defaults (all optional)
EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_OUTPUT_FORMAT=audio-24khz-96kbitrate-mono-mp3
EDGE_TTS_PITCH=+2%
EDGE_TTS_RATE=-10%
EDGE_TTS_VOLUME=100%
EDGE_TTS_TIMEOUT_MS=20000
EDGE_TTS_MAX_RETRIES=2
EDGE_TTS_RETRY_BASE_DELAY_MS=750
EDGE_TTS_RETRY_MAX_DELAY_MS=8000
EDGE_TTS_RETRY_BUDGET_MS=45000

KOKORO_ENABLED=true
KOKORO_PREWARM=false
KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_DTYPE=q8
KOKORO_VOICE=af_heart
KOKORO_SPEED=1
KOKORO_CACHE_DIR=.cache/kokoro
KOKORO_COOLDOWN_MS=300000
KOKORO_FAILURE_THRESHOLD=3

AUDIO_QUEUE_CONCURRENCY=2
AUDIO_QUEUE_MAX_SIZE=1000
TTS_MP3_BITRATE_KBPS=64

# Maximum time each cleanup step may take on SIGINT/SIGTERM.
SHUTDOWN_TIMEOUT_MS=15000
